# Required for real Gemini calls. Get a key from Google AI Studio.
GEMINI_API_KEY=

# Optional model overrides. Defaults reflect Google's current image-generation guidance.
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Change this before deploying. A local development default is used when unset.
SESSION_SECRET=
